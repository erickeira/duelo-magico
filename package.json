{
  "name": "duelo-magico",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "validate": "node scripts/validate-content.mjs",
    "wiki:dev": "vitepress dev wiki --port 5181",
    "wiki:build": "npm run validate && vitepress build wiki",
    "wiki:preview": "vitepress preview wiki",
    "art:process": "python3 scripts/process-cards.py && python3 scripts/process-frames.py"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitepress": "^1.6.4",
    "vue": "^3.5.43"
  }
}
